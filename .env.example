# Copy to .env.local for development. Never commit real values.

# PostgreSQL (local, Neon, Supabase, RDS…)
DATABASE_URL=postgres://localhost:5432/eventpage

# Public base URL — used for payment redirects and staff invite links
APP_URL=http://localhost:3000

# HMAC key that signs QR ticket tokens. 32+ random chars: `openssl rand -hex 32`
# Rotating it invalidates every issued QR code.
TICKET_SIGNING_SECRET=

# Protects /api/cron/expire-orders (sent as `Authorization: Bearer <secret>`)
CRON_SECRET=

# ── Payments ────────────────────────────────────────────────
# Stripe (use sk_test_… until you go live). When set, Stripe Checkout is used.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local test gateway — only active when STRIPE_SECRET_KEY is empty AND NODE_ENV != production
DEV_PAYMENT_WEBHOOK_SECRET=

# ── Object storage ──────────────────────────────────────────
# Vercel Blob token for hero images. Without it, uploads go to public/uploads (dev only).
BLOB_READ_WRITE_TOKEN=
# Your store's public host, e.g. abc123.public.blob.vercel-storage.com (pins accepted image URLs)
BLOB_PUBLIC_HOST=

# ── Rate limiting ───────────────────────────────────────────
# Header your proxy sets with the real client IP (x-real-ip, fly-client-ip, cf-connecting-ip…).
# Auto-detected on Vercel. Unset = all clients share one bucket (fine for local dev only).
TRUSTED_IP_HEADER=
